# --- Server ---
NODE_ENV=development
PORT=3000

# --- Docker only: host-side port mappings ---
# Change these if 3000/5433 are already taken on your machine by another
# project (docker-compose.yml maps these to the containers' fixed internal
# ports 3000/5432, so the app/db themselves are unaffected).
HOST_APP_PORT=3000
HOST_DB_PORT=5433

# --- Database (PostgreSQL) ---
# For docker-compose these are also read directly by the "db" service.
SQL_HOST=localhost
SQL_DB_NAME=imara_mfi
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres
# Optional: if set, these override SQL_ADMIN_USER/SQL_ADMIN_PASSWORD for the
# app's own connection (drizzle-kit still uses SQL_ADMIN_USER/PASSWORD).
# SQL_USER=
# SQL_PASSWORD=

# Enable TLS for the database connection. Defaults to off for localhost/db
# (Docker) hosts and on for anything else, so this is usually only needed to
# override that default explicitly. Managed providers (Neon, Supabase, RDS)
# require SQL_SSL=true for external connections, e.g. when deploying to Vercel.
# SQL_SSL=true

# --- Auth ---
# Required in any real deployment - the server refuses to start in production
# without these. Generate values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret used to verify inbound mobile money provider webhooks
# (M-Pesa/Airtel Money/Tigo Pesa). The provider must sign each callback with
# this same secret - see POST /api/mobile-money/webhook in server.ts.
MOMO_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Optional: Gemini AI ---
# Not currently called anywhere in this codebase (leftover from the AI Studio
# template). Only needed if you wire up an actual @google/genai call.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
